# Copy this file to .env and replace every value marked "replace-".
# Keep .env out of version control. Prefer the deployment's mounted-secret
# mechanism for bearer, database, and AI credentials.

# Server
LISTEN_ADDRESS=0.0.0.0:8080
PUBLIC_BASE_URL=https://attic.example.invalid
BEARER_TOKEN=replace-with-a-long-random-owner-token
TRUSTED_PROXY_CIDRS=

# Existing external PostgreSQL 14+; this example does not create a database.
# Backup commands should use a separately mounted 0600 .pgpass/PGSERVICE
# configuration rather than expanding this credential-bearing URL into argv.
DATABASE_URL=postgres://attic:replace-with-database-password@db.example.invalid:5432/attic?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=5

# Persistent application data. The Compose example mounts /data.
ARTIFACT_ROOT=/data/artifacts
DIAGNOSTIC_RETENTION=disabled

# Select api (default) or chatgpt (direct subscription OAuth).
# With chatgpt, run attic login-chatgpt; AI_API_KEY and AI_BASE_URL are unused.
AI_PROVIDER=api
CHATGPT_AUTH_FILE=/data/auth/chatgpt.json

# OpenAI-compatible provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-ai-provider-key
AI_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=medium
AI_TIMEOUT=90s
AI_MAX_RETRIES=2

# Browser limits.
BROWSER_EXECUTABLE=/usr/bin/chromium-browser
BROWSER_NAVIGATION_TIMEOUT=30s
BROWSER_RENDER_TIMEOUT=15s
BROWSER_CONCURRENCY=1
BROWSER_MAX_REDIRECTS=5
BROWSER_MAX_RESPONSE_BYTES=20000000
BROWSER_MAX_DOM_BYTES=10000000
BROWSER_MAX_DOM_NODES=100000
BROWSER_MAX_SCREENSHOT_BYTES=5000000
BROWSER_SCREENSHOT_WIDTH=1280
BROWSER_SCREENSHOT_HEIGHT=1600

# PDF output (one active profile per deployment in V1).
# Use kindle-scribe for a 3:4 portrait page (157.5 × 210 mm); a5 is also supported.
PDF_PROFILE=kindle-scribe
PDF_MARGIN_MM=12
PDF_BODY_FONT_PT=11
PDF_LINE_HEIGHT=1.25
PDF_MAX_BYTES=25000000
PDF_TIMEOUT=45s

# Enable explicit Send to Kindle requests. Bookmarking never sends email.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=attic@example.com
SMTP_DESTINATION=reader@example.com
SMTP_TIMEOUT=30s
# implicit_tls is supported on port 465. none is only for unauthenticated
# local catchers. compose.mail-test.yaml routes email to Mailpit.

# External full-collection search. compose.search.yaml wires these values.
SEARCH_URL=
SEARCH_API_KEY=
SEARCH_INDEX=attic
MEILI_MASTER_KEY=replace-with-a-random-key-at-least-16-bytes
