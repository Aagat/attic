# Copy this file to .env and replace every value marked "replace-".
# Keep .env out of version control. Prefer the deployment's mounted-secret
# mechanism for bearer, database, AI, and SMTP credentials.

# Server
LISTEN_ADDRESS=0.0.0.0:8080
PUBLIC_BASE_URL=https://attic.example.invalid
BEARER_TOKEN=replace-with-a-long-random-owner-token
TRUSTED_PROXY_CIDRS=

# Existing external PostgreSQL 14+; this example does not create a database.
# Backup commands should use a separately mounted 0600 .pgpass/PGSERVICE
# configuration rather than expanding this credential-bearing URL into argv.
DATABASE_URL=postgres://attic:replace-with-database-password@db.example.invalid:5432/attic?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=5

# Persistent application data. The Compose example mounts /data.
ARTIFACT_ROOT=/data/artifacts
DIAGNOSTIC_RETENTION=disabled

# OpenAI-compatible provider. AI_API_KEY is provider-neutral and preferred;
# OPENAI_API_KEY is accepted as a compatibility alias when AI_API_KEY is empty.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-ai-provider-key
AI_MODEL=gpt-5.6-luna
AI_REASONING_EFFORT=medium
AI_TIMEOUT=90s
AI_MAX_RETRIES=2

# Browser limits.
BROWSER_EXECUTABLE=/usr/bin/chromium-browser
BROWSER_NAVIGATION_TIMEOUT=30s
BROWSER_RENDER_TIMEOUT=15s
BROWSER_CONCURRENCY=1
BROWSER_MAX_REDIRECTS=5
BROWSER_MAX_RESPONSE_BYTES=20000000
BROWSER_MAX_DOM_BYTES=10000000
BROWSER_MAX_DOM_NODES=100000
BROWSER_MAX_SCREENSHOT_BYTES=5000000
BROWSER_SCREENSHOT_WIDTH=1280
BROWSER_SCREENSHOT_HEIGHT=1600

# PDF output (one active profile per deployment in V1).
PDF_PROFILE=a5
PDF_MARGIN_MM=10
PDF_BODY_FONT_PT=11
PDF_LINE_HEIGHT=1.4
PDF_MAX_BYTES=25000000
PDF_TIMEOUT=45s

# SMTP delivery settings are reserved for the delivery adapter, which is not
# composed in the current foundation. Keep SMTP_ENABLED=false until it lands.
# If enabled later, configure TLS and both addresses. Plaintext SMTP is not
# supported.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SENDER=attic@example.invalid
SMTP_DESTINATION=reader@example.invalid
SMTP_TIMEOUT=30s
