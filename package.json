{
  "name": "attic-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @attic/ui dev",
    "build": "pnpm --filter @attic/ui build",
    "preview": "pnpm --filter @attic/ui preview",
    "test:ui": "pnpm --filter @attic/ui test",
    "build:preview": "VITE_UI_PREVIEW=true pnpm build",
    "build:embed": "pnpm build && node ui/embed.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
