                          "fontFamily": "$font-body",
                          "fontSize": 9,
                          "fontWeight": "700",
                          "letterSpacing": 1.3
                        },
                        {
                          "type": "text",
                          "id": "LIsYN",
                          "name": "Callout Text",
                          "fill": "$ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Forward compatibility: newer code can read data written by older code.",
                          "lineHeight": 1.4,
                          "fontFamily": "$font-body",
