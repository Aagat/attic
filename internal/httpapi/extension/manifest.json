{
  "manifest_version": 3,
  "name": "Attic",
  "version": "0.4.3",
  "description": "Bookmarks, search, and Kindle delivery.",
  "permissions": [
    "activeTab",
    "pageCapture",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Attic",
    "default_icon": "icon-192.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "192": "icon-192.png",
    "16": "icon-192.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "optional_permissions": [
    "bookmarks"
  ],
  "omnibox": {
    "keyword": "a"
  }
}
